{
  "manifest_version": 3,
  "name": "Drag to Sheets",
  "version": "1.0.3",
  "version_name": "1.0.3",
  "description": "Drag spreadsheet files to open and clean them in Google Sheets",
  "author": { "email": "support@dragtosheets.com", "name": "Drag to Sheets" },
  "homepage_url": "https://www.dragtosheets.com/",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Open Drag to Sheets",
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/wa-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/wa-content.js"],
      "css": ["content/wa-content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/icon-48.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Drag to Sheets panel"
    }
  },
  "oauth2": {
    "client_id": "1085463726022-liacdqopbe792mkhjvhtk5aqp69tad7v.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
